# --- Spring Boot ---
FIREBASE_CREDENTIALS_PATH=/secrets/firebase-service-account.json   # never commit this file
ML_SERVICE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173
OPD_TIMEZONE=Asia/Kolkata
OPD_SEED_ENABLED=false            # set true once to seed departments/doctors/users
# Dev seed passwords (min 8 chars). Leave unset to skip creating that user.
SEED_ADMIN_PASSWORD=
SEED_RECEPTIONIST_PASSWORD=
SEED_DOCTOR_PASSWORD=
SEED_PATIENT_PASSWORD=
# --- ML service ---
MIN_TRAIN_SAMPLES=100
# --- React (frontend/.env) ---
VITE_API_URL=http://localhost:8080
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
